model Role {
    id        Int      @id @default(autoincrement())
    name      String   @db.VarChar(200)
    createdAt DateTime @default(now()) @db.Timestamptz()
    updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz()

    rolePermissions RolePermissions[]
    userRoles       UserRole[]

    @@map("roles")
}
