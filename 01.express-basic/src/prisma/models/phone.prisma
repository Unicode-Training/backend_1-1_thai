model Phone {
    id        Int      @id @default(autoincrement())
    phone     String
    userId    Int      @unique
    createdAt DateTime @default(now()) @db.Timestamptz()
    updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz()
    user      User     @relation(fields: [userId], references: [id])

    @@map("phone")
}
